---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Alex del Valle — Systems and Automation Engineer focused on reliability, Site Reliability Engineering and technical leadership.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">Alex del Valle</a>

        <nav aria-label="Main navigation">
          <a href="/projects">Projects</a>
          <a href="/engineering">Engineering</a>
          <a href="/experience">Experience</a>
          <a href="/about">About</a>

          <a
            href="https://github.com/alexdelvallegordo"
            target="_blank"
            rel="noreferrer"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Built and maintained by Alex del Valle.</p>
      </div>
    </footer>
  </body>
</html>
