---
import BaseLayout from "../layouts/BaseLayout.astro";

const technologies = [
  "Linux",
  "AWX",
  "Kubernetes",
  "Kind",
  "Podman",
  "Python",
  "FastAPI",
  "Prometheus",
  "Grafana",
  "Helm",
  "GitHub Actions",
  "NGINX Ingress",
];

const capabilities = [
  "Build and operate an AWX automation platform on Kubernetes.",
  "Develop a custom FastAPI service to monitor AWX and Kubernetes health.",
  "Expose application metrics to Prometheus and visualize reliability data in Grafana.",
  "Package and operate the application with Helm, health probes, resource controls and least-privilege RBAC.",
  "Run containers as non-root with a read-only root filesystem and restricted capabilities.",
  "Route multiple services through NGINX Ingress using local DNS-style hostnames.",
  "Validate application code, Helm packaging and container builds through CI.",
  "Automate lab startup and operational access through repeatable bootstrap scripts.",
  "Observe workload failure and recovery behaviour and document operational findings.",
];
---

<BaseLayout
  title="Projects | Alex del Valle"
  description="Engineering projects by Alex del Valle focused on reliability, automation, observability and production-style system operation."
>
  <section class="projects-page">
    <div class="container">
      <div class="projects-intro">
        <p class="eyebrow">Engineering projects</p>

        <h1>
          Systems built to be operated, observed and improved.
        </h1>

        <p class="lead">
          Selected engineering work focused on reliability, automation and
          operability. Projects are treated as systems rather than isolated
          technology exercises, with architecture, operational controls,
          failure modes and documentation.
        </p>
      </div>


      <div class="project-list">
        <article class="project-entry">
          <div class="project-meta">
            <span>01</span>
            <span class="tag">Active</span>
          </div>

          <div>
            <h2>Automation Platform Reliability</h2>

            <p>
              A production-style automation environment that combines platform
              engineering and Site Reliability Engineering. The project starts
              with an AWX platform running on Kubernetes and extends it with
              custom health monitoring, metrics, dashboards, deployment
              automation and operational tooling.
            </p>

            <div class="stack">
              {
                technologies.map((technology) => (
                  <span class="tag">{technology}</span>
                ))
              }
            </div>

            <h3>What it demonstrates</h3>

            <ul>
              {
                capabilities.map((capability) => (
                  <li>{capability}</li>
                ))
              }
            </ul>

            <h3>Architecture</h3>

            <p>
              AWX provides the automation workload. Platform Health, a custom
              Python/FastAPI service, evaluates application and Kubernetes
              health. Prometheus collects reliability metrics, Grafana provides
              historical visibility, Helm manages deployment lifecycle and
              NGINX Ingress exposes the platform through a single entry point.
            </p>

            <div class="button-group">
              <a
                class="button primary"
                href="https://github.com/alexdelvallegordo/platform-health"
                target="_blank"
                rel="noreferrer"
              >
                Platform Health repository
              </a>

              <a
                class="button"
                href="https://github.com/alexdelvallegordo/automation-platform-lab"
                target="_blank"
                rel="noreferrer"
              >
                Platform lab repository
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>


  <section>
    <div class="container">
      <p class="eyebrow">Engineering scope</p>

      <h2>One system, multiple engineering disciplines.</h2>

      <div class="grid">
        <article class="card">
          <span class="tag">Platform</span>

          <h3>Build and operate</h3>

          <p>
            Kubernetes workloads, AWX, Helm packaging, RBAC, container
            security, Services, Ingress and repeatable environment startup.
          </p>
        </article>

        <article class="card">
          <span class="tag">Software</span>

          <h3>Build operational tooling</h3>

          <p>
            A Python/FastAPI service with health models, API endpoints,
            concurrent checks, automated tests and containerized delivery.
          </p>
        </article>

        <article class="card">
          <span class="tag">SRE</span>

          <h3>Measure and understand reliability</h3>

          <p>
            Health semantics, Prometheus metrics, Grafana dashboards, alert
            rules, troubleshooting and controlled failure analysis.
          </p>
        </article>

        <article class="card">
          <span class="tag">Operations</span>

          <h3>Reduce operational friction</h3>

          <p>
            Bootstrap automation, documented recovery behaviour and an
            environment designed to support repeatable diagnosis rather than
            manual guesswork.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
