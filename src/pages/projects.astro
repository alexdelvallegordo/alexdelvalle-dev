---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "Automation Platform Lab",
    status: "In progress",
    description:
      "A hands-on Platform Engineering environment using AWX and Kubernetes to explore platform operations, workload behaviour, troubleshooting and reliability.",
    technologies: [
      "AWX",
      "Kubernetes",
      "Kind",
      "Podman",
      "Linux",
    ],
    goals: [
      "Operate and troubleshoot a Kubernetes-based automation platform",
      "Introduce controlled failures and document recovery behaviour",
      "Build operational runbooks and reliability experiments",
      "Progressively introduce automation, observability and SRE practices",
    ],
    repository:
      "https://github.com/alexdelvallegordo/automation-platform-lab",
  },
  {
    number: "02",
    title: "Production Platform Lab",
    status: "Planned",
    description:
      "A production-like platform focused on Kubernetes, deployment workflows, GitOps and reliable application delivery.",
    technologies: [
      "Kubernetes",
      "Helm",
      "GitOps",
      "CI/CD",
    ],
    goals: [
      "Deploy and operate containerized workloads",
      "Introduce repeatable deployment workflows",
      "Implement GitOps-based configuration management",
      "Explore reliability and deployment strategies",
    ],
  },
  {
    number: "03",
    title: "Infrastructure as Code Lab",
    status: "Planned",
    description:
      "Cloud infrastructure built through Infrastructure as Code with a focus on reproducibility, networking, security and operational consistency.",
    technologies: [
      "Terraform",
      "AWS",
      "IAM",
      "VPC",
    ],
    goals: [
      "Provision infrastructure through code",
      "Design reusable Terraform configurations",
      "Understand cloud networking and IAM",
      "Build reproducible infrastructure environments",
    ],
  },
  {
    number: "04",
    title: "Reliability Engineering Lab",
    status: "Planned",
    description:
      "An SRE-focused environment for observability, service reliability, incident response and measurable operational objectives.",
    technologies: [
      "Prometheus",
      "Grafana",
      "OpenTelemetry",
      "Kubernetes",
    ],
    goals: [
      "Implement metrics and observability",
      "Define SLIs and SLOs",
      "Create meaningful alerts",
      "Practice incident response and postmortems",
    ],
  },
];
---

<BaseLayout title="Projects | Alex del Valle">
  <section class="projects-page">
    <div class="container">
      <div class="projects-intro">
        <p class="eyebrow">Engineering projects</p>

        <h1>Learning by building and operating systems.</h1>

        <p class="lead">
          Hands-on projects focused on Platform Engineering, automation,
          Kubernetes, Infrastructure as Code and Site Reliability Engineering.
        </p>
      </div>

      <div class="project-list">
        {
          projects.map((project) => (
            <article class="project-entry">
              <div class="project-meta">
                <span>{project.number}</span>
                <span class="tag">{project.status}</span>
              </div>

              <div>
                <h2>{project.title}</h2>

                <p>{project.description}</p>

                <div class="stack">
                  {project.technologies.map((technology) => (
                    <span class="tag">{technology}</span>
                  ))}
                </div>

                <h3>Engineering goals</h3>

                <ul>
                  {project.goals.map((goal) => (
                    <li>{goal}</li>
                  ))}
                </ul>

                {
                  project.repository && (
                    <div class="button-group">
                      <a
                        class="button"
                        href={project.repository}
                        target="_blank"
                        rel="noreferrer"
                      >
                        View repository
                      </a>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
