---
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = [
  {
    type: "Reliability Experiment",
    status: "Published",
    title: "Kubernetes Pod Failure and Automatic Recovery",
    description:
      "A controlled AWX Web pod failure used to observe ReplicaSet reconciliation, workload replacement, ephemeral Pod addressing and automatic Service endpoint updates.",
    topics: [
      "Kubernetes",
      "AWX",
      "Reliability",
      "Troubleshooting",
    ],
    href:
      "https://github.com/alexdelvallegordo/automation-platform-lab/blob/main/docs/reliability/pod-failure-recovery.md",
    action: "Read experiment",
  },
  {
    type: "Incident Simulation",
    status: "Planned",
    title: "Failed Kubernetes Rollout",
    description:
      "A controlled deployment failure using an invalid container image, followed by diagnosis, root cause analysis, recovery and preventive actions.",
    topics: [
      "Kubernetes",
      "ImagePullBackOff",
      "Incident response",
      "Rollback",
    ],
  },
  {
    type: "Architecture Decision",
    status: "Planned",
    title: "Workload and Service Exposure Strategy",
    description:
      "An architecture decision record documenting workload deployment and service exposure choices, including trade-offs and operational implications.",
    topics: [
      "Architecture",
      "Kubernetes",
      "ADR",
      "Platform Engineering",
    ],
  },
  {
    type: "Case Study",
    status: "Planned",
    title: "Reducing an Infrastructure Patching Window",
    description:
      "A sanitized engineering case study covering the analysis and improvement of an infrastructure patching process, reducing execution time from approximately seven hours to four.",
    topics: [
      "Automation",
      "Operations",
      "Process improvement",
      "Reliability",
    ],
  },
];
---

<BaseLayout title="Engineering | Alex del Valle">
  <section>
    <div class="container">
      <p class="eyebrow">Engineering</p>

      <h1>Decisions, failures and lessons learned while building systems.</h1>

      <p class="lead">
        Technical notes focused on architecture, reliability, troubleshooting,
        incident analysis and the reasoning behind engineering decisions.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="engineering-list">
        {
          entries.map((entry) => (
            <article class="engineering-entry">
              <div class="engineering-meta">
                <span>{entry.type}</span>
                <span class="tag">{entry.status}</span>
              </div>

              <div>
                <h3>{entry.title}</h3>

                <p>{entry.description}</p>

                <div class="stack">
                  {entry.topics.map((topic) => (
                    <span class="tag">{topic}</span>
                  ))}
                </div>

                {
                  entry.href && (
                    <div class="button-group">
                      <a
                        class="button"
                        href={entry.href}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {entry.action}
                      </a>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
