---
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = [
  {
    type: "Engineering system",
    status: "Active",
    title: "Automation Platform Reliability",
    description:
      "A production-style automation platform combining AWX, Kubernetes, custom health monitoring, Prometheus, Grafana, Helm, CI and Ingress. The project focuses on operability, observability and reliability rather than infrastructure deployment alone.",
    topics: [
      "SRE",
      "Automation",
      "Observability",
      "Kubernetes",
      "Python",
    ],
    href: "https://github.com/alexdelvallegordo/platform-health",
    action: "View repository",
  },
  {
    type: "Reliability experiment",
    status: "Published",
    title: "Kubernetes Pod Failure and Automatic Recovery",
    description:
      "A controlled AWX Web pod failure used to observe ReplicaSet reconciliation, workload replacement, ephemeral Pod addressing and automatic Service endpoint updates.",
    topics: [
      "Kubernetes",
      "AWX",
      "Reliability",
      "Troubleshooting",
    ],
    href:
      "https://github.com/alexdelvallegordo/automation-platform-lab/blob/main/docs/reliability/pod-failure-recovery.md",
    action: "Read experiment",
  },
  {
    type: "Operational improvement",
    status: "Professional impact",
    title: "Reducing an Infrastructure Patching Window",
    description:
      "A production improvement that redesigned an infrastructure patching workflow, reducing the execution window from approximately seven hours to four while strengthening validation and operational control.",
    topics: [
      "Automation",
      "Operations",
      "Reliability",
      "Process improvement",
    ],
  },
  {
    type: "Technical leadership",
    status: "Professional experience",
    title: "Leading Platform Migration Work",
    description:
      "Technical ownership across migration planning, dependency analysis, risk assessment, cross-team coordination, execution and validation in an enterprise production environment.",
    topics: [
      "Leadership",
      "Migration",
      "Risk management",
      "Service ownership",
    ],
  },
];
---

<BaseLayout
  title="Engineering | Alex del Valle"
  description="Engineering work by Alex del Valle: reliability experiments, technical decisions, troubleshooting and sanitized professional case studies."
>
  <section>
    <div class="container">
      <p class="eyebrow">Engineering</p>

      <h1>
        Reliability work, engineering decisions and operational impact.
      </h1>

      <p class="lead">
        Selected technical work covering systems design, troubleshooting,
        reliability experiments and sanitized professional experience. The
        focus is on the problem, the engineering decision, the operational
        outcome and what changed afterwards.
      </p>
    </div>
  </section>


  <section>
    <div class="container">
      <div class="engineering-list">
        {
          entries.map((entry) => (
            <article class="engineering-entry">
              <div class="engineering-meta">
                <span>{entry.type}</span>
                <span class="tag">{entry.status}</span>
              </div>

              <div>
                <h3>{entry.title}</h3>

                <p>{entry.description}</p>

                <div class="stack">
                  {entry.topics.map((topic) => (
                    <span class="tag">{topic}</span>
                  ))}
                </div>

                {
                  entry.href && (
                    <div class="button-group">
                      <a
                        class="button"
                        href={entry.href}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {entry.action}
                      </a>
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
