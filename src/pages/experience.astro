---
import BaseLayout from "../layouts/BaseLayout.astro";

const currentCapabilities = [
  "Ansible Automation Platform",
  "Linux",
  "Service ownership",
  "People leadership",
  "Technical coordination",
  "Incident response",
  "Problem management",
  "Automation",
  "REST APIs",
  "Reliability improvement",
  "Migrations & upgrades",
];

const linuxCapabilities = [
  "Red Hat Linux",
  "Technical leadership",
  "Production operations",
  "Troubleshooting",
  "Incident coordination",
  "Change management",
  "Process improvement",
  "Migrations & upgrades",
  "Middleware infrastructure",
];
---

<BaseLayout
  title="Experience | Alex del Valle"
  description="Professional experience of Alex del Valle across Linux infrastructure, automation platforms, production operations, reliability and technical leadership."
>
  <section>
    <div class="container">
      <p class="eyebrow">Experience</p>

      <h1>
        Systems, automation, reliability and technical leadership.
      </h1>

      <p class="lead">
        My career has evolved from Linux infrastructure and enterprise
        production operations into automation platform ownership, with
        increasing responsibility for people leadership, incident response,
        technical decisions and measurable operational improvement.
      </p>
    </div>
  </section>


  <section>
    <div class="container experience-list">

      <!-- ================================================== -->
      <!-- CURRENT ROLE -->
      <!-- ================================================== -->

      <article class="experience">

        <div class="experience-meta">
          <span>Current</span>
          <span>Automation Platform</span>
        </div>


        <div>
          <p class="eyebrow">
            Current role
          </p>

          <h2>
            Automation Platform & Systems Administration
          </h2>

          <p class="lead">
            Enterprise automation role combining Linux and Ansible Automation
            Platform engineering with service ownership, people leadership,
            troubleshooting and cross-team technical coordination.
          </p>

          <p>
            The role sits between hands-on platform operation and service
            leadership: keeping the platform reliable today while improving
            how the team operates, diagnoses problems and delivers change.
          </p>


          <h3>
            Selected responsibilities & impact
          </h3>

          <ul class="experience-points">

            <li>
              Own and coordinate the technical health and day-to-day operation
              of enterprise automation infrastructure based on Linux and
              Ansible Automation Platform.
            </li>

            <li>
              Lead team coordination and work across development,
              infrastructure and service teams to translate operational needs
              into technical actions.
            </li>

            <li>
              Drive troubleshooting and problem management during application,
              service and platform incidents, focusing on recovery, root cause
              and preventive improvement.
            </li>

            <li>
              Lead and contribute to platform migrations, upgrades and
              lifecycle activities involving dependencies, operational risk
              and service impact.
            </li>

            <li>
              Redesigned an infrastructure patching workflow, reducing the
              operational window from approximately 7 hours to 4 hours while
              improving validation and control.
            </li>

            <li>
              Analyse failures in unattended changes, classify recurring causes
              and coordinate corrective actions with the teams responsible for
              the affected components.
            </li>

            <li>
              Improve repeatability through runbooks, connectivity checks,
              reusable automation, snapshot automation and standardized
              operational procedures.
            </li>

          </ul>


          <h3>
            Core technologies & practices
          </h3>

          <div class="stack">
            {
              currentCapabilities.map((capability) => (
                <span class="tag">
                  {capability}
                </span>
              ))
            }
          </div>

        </div>

      </article>


      <!-- ================================================== -->
      <!-- PREVIOUS EXPERIENCE -->
      <!-- ================================================== -->

      <article class="experience">

        <div class="experience-meta">
          <span>Previous</span>
          <span>Linux Infrastructure</span>
        </div>


        <div>
          <p class="eyebrow">
            Previous experience
          </p>

          <h2>
            Linux Infrastructure Technical Lead
          </h2>

          <p class="lead">
            Enterprise Linux infrastructure role combining hands-on systems
            administration, production troubleshooting, technical leadership
            and cross-team coordination.
          </p>

          <p>
            This stage built the systems and operational foundation behind my
            current focus on automation and reliability engineering.
          </p>


          <h3>
            Selected responsibilities
          </h3>

          <ul class="experience-points">

            <li>
              Acted as a technical reference for Linux infrastructure,
              coordinating work across infrastructure, middleware and
              application teams.
            </li>

            <li>
              Managed Red Hat Linux production environments including
              maintenance, patching, upgrades and lifecycle activities.
            </li>

            <li>
              Coordinated technical actions during incidents, changes and
              infrastructure problems involving multiple teams and system
              dependencies.
            </li>

            <li>
              Participated in migrations and upgrades while evaluating
              dependencies, operational risk and service impact.
            </li>

            <li>
              Standardized recurring operational work through documentation,
              runbooks and repeatable processes, progressively introducing
              automation where manual work created unnecessary risk or effort.
            </li>

          </ul>


          <h3>
            Core technologies & practices
          </h3>

          <div class="stack">
            {
              linuxCapabilities.map((capability) => (
                <span class="tag">
                  {capability}
                </span>
              ))
            }
          </div>

        </div>

      </article>

    </div>
  </section>
</BaseLayout>
