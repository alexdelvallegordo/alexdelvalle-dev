---
import BaseLayout from "../layouts/BaseLayout.astro";

const principles = [
  {
    title: "Incident response",
    description:
      "Restore service quickly, reduce uncertainty and then understand the failure well enough to make recurrence less likely.",
  },
  {
    title: "Automation",
    description:
      "Repeated manual work is a signal to simplify, standardize or automate a process when doing so improves reliability and reduces operational risk.",
  },
  {
    title: "Ownership",
    description:
      "I prefer understanding systems end-to-end, including their dependencies, failure modes and operational impact, rather than treating infrastructure as isolated tasks.",
  },
  {
    title: "Leadership",
    description:
      "Technical decisions become more valuable when teams have clear ownership, shared context and a practical path from problem to action.",
  },
];
---

<BaseLayout
  title="About | Alex del Valle"
  description="About Alex del Valle — Systems and Automation Engineer focused on reliability, Site Reliability Engineering and technical leadership."
>
  <section>
    <div class="container">
      <p class="eyebrow">About</p>

      <h1>
        I build and operate systems with reliability in mind.
      </h1>

      <p class="lead">
        I'm Alex del Valle, a systems and automation engineer with a background
        in Linux infrastructure, enterprise production environments,
        troubleshooting and technical leadership.
      </p>

      <p class="lead">
        My career has moved from traditional systems administration into
        automation platform ownership and service leadership. My professional
        direction is Site Reliability Engineering: combining strong systems
        fundamentals with software, observability, automation and a disciplined
        approach to operational reliability.
      </p>
    </div>
  </section>


  <section>
    <div class="container">
      <p class="eyebrow">Engineering mindset</p>

      <h2>How I approach production systems.</h2>

      <div class="grid">
        {
          principles.map((principle) => (
            <article class="card">
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <section>
    <div class="container">
      <p class="eyebrow">Why SRE</p>

      <h2>
        Recovery is only the first half of the job.
      </h2>

      <p class="lead">
        The part of operations I value most is responding effectively when
        something fails: understanding the symptoms, restoring service and then
        changing the system or process so the same problem is less likely to
        happen again.
      </p>

      <p>
        I want to combine that engineering depth with service ownership and
        people leadership. Long term, my direction is SRE leadership and
        engineering management with enough technical depth to make credible
        decisions about the systems and teams I am responsible for.
      </p>

      <div class="button-group">
        <a class="button primary" href="/projects">
          View engineering work
        </a>

        <a class="button" href="/experience">
          View experience
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
