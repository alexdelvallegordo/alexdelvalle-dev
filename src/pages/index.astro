---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Production Platform Lab",
    status: "Planned",
    description:
      "A production-like platform for learning containers, Kubernetes, GitOps and reliability engineering.",
  },
  {
    title: "Infrastructure as Code Lab",
    status: "Planned",
    description:
      "Cloud infrastructure built with Terraform and AWS, focusing on networking, IAM and reproducibility.",
  },
  {
    title: "Reliability Engineering Lab",
    status: "Planned",
    description:
      "An SRE-focused environment for observability, SLOs, alerting, incident response and postmortems.",
  },
];
---

<BaseLayout title="Alex del Valle | Platform & Automation Engineer">
  <section>
    <div class="container">
      <p class="eyebrow">Platform & Automation Engineer</p>

      <h1>
        Automation engineer building toward reliable platforms.
      </h1>

      <p class="lead">
        I'm Alex del Valle, a Linux and Ansible Automation Platform engineer
    expanding into Kubernetes, Infrastructure as Code, cloud and Site
    Reliability Engineering through production work and hands-on engineering
    projects.
      </p>

      <div class="button-group">
        <a class="button primary" href="/projects">View engineering projects</a>

        <a
          class="button"
          href="https://github.com/alexdelvallegordo"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Current direction</p>
      <h2>From automation to reliability engineering.</h2>

      <p class="lead">
        My current professional background is centered on Linux, Ansible and
        automation platforms. I'm expanding that foundation into Kubernetes,
        infrastructure as code, cloud platforms and production reliability.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">Engineering projects</p>
      <h2>Learning by building.</h2>

      <div class="grid">
        {
          projects.map((project) => (
            <article class="card">
              <span class="tag">{project.status}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
