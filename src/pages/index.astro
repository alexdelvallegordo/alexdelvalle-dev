---
import BaseLayout from "../layouts/BaseLayout.astro";

const impact = [
  {
    type: "Operational improvement",
    title: "~43% shorter patching window",
    description:
      "Redesigned an infrastructure patching workflow, reducing the operational window from approximately 7 hours to 4 while improving validation and control.",
  },
  {
    type: "Reliability improvement",
    title: "Unattended change failures",
    description:
      "Analysing recurring failures, classifying root causes and coordinating corrective actions to improve the reliability of unattended operational changes.",
  },
  {
    type: "Technical leadership",
    title: "Platform migration",
    description:
      "Led technical coordination, dependency analysis, operational planning and execution across teams during platform migration work.",
  },
];
---

<BaseLayout
  title="Alex del Valle | Systems, Automation & Reliability"
  description="Alex del Valle — Systems and Automation Engineer with a strong Linux background, production ownership, technical leadership and a focus on Site Reliability Engineering."
>
  <section>
    <div class="container">
      <p class="eyebrow">
        Systems & Automation Engineer · SRE focused
      </p>

      <h1>
        Systems, automation and reliability.
      </h1>

      <p class="lead">
        I'm Alex del Valle, an infrastructure and automation engineer with a
        strong Linux background, production ownership and people leadership.
        I focus on making systems easier to operate, faster to recover and less
        likely to fail twice.
      </p>

      <div class="button-group">
        <a class="button primary" href="/projects">
          View engineering work
        </a>

        <a
          class="button"
          href="https://github.com/alexdelvallegordo"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
      </div>
    </div>
  </section>


  <section>
    <div class="container">
      <p class="eyebrow">Engineering direction</p>

      <h2>
        From operating infrastructure to engineering reliability.
      </h2>

      <p class="lead">
        My professional foundation is Linux, automation, troubleshooting and
        enterprise production operations. Today I combine that background with
        platform ownership, incident and problem management, automation and
        cross-team leadership while deepening my work in Site Reliability
        Engineering.
      </p>
    </div>
  </section>


<section>
  <div class="container">
    <p class="eyebrow">Featured engineering</p>

    <h2>Automation Platform Reliability</h2>

    <article class="card">
      <span class="tag">Active project</span>

      <h3>
        Building and operating an observable automation platform.
      </h3>

      <p>
        A production-style environment built around AWX and Kubernetes,
        extended with a custom FastAPI health service, Prometheus, Grafana,
        Helm, CI, RBAC, hardened containers and NGINX Ingress.
      </p>

      <p>
        The project focuses on the complete operational lifecycle:
        deploying the platform, observing its health, automating access,
        understanding failure modes and improving reliability.
      </p>

      <div class="stack">
        <span class="tag">Linux</span>
        <span class="tag">AWX</span>
        <span class="tag">Kubernetes</span>
        <span class="tag">Python</span>
        <span class="tag">Prometheus</span>
        <span class="tag">Grafana</span>
        <span class="tag">Helm</span>
      </div>

      <div class="button-group">
        <a class="button primary" href="/projects">
          Explore project
        </a>

        <a
          class="button"
          href="https://github.com/alexdelvallegordo/platform-health"
          target="_blank"
          rel="noreferrer"
        >
          View repository
        </a>
      </div>
    </article>
  </div>
</section>

  <section>
    <div class="container">
      <p class="eyebrow">Engineering impact</p>

      <h2>Production experience measured by outcomes.</h2>

      <div class="grid">
        {
          impact.map((item) => (
            <article class="card">
              <span class="tag">{item.type}</span>

              <h3>{item.title}</h3>

              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
